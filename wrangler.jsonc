{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar-widgets",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DEPLOYMENT_VERSION": "development"
  }
}
